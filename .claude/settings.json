{
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -Command \"& \\\"$env:PAI_DIR/scripts/statusline.ps1\\\"\""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/initialize-session.ts\""
          },
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/load-core-context.ts\""
          },
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/capture-all-events.ts --event-type SessionStart\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/security-validator.ts\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/capture-all-events.ts --event-type PreToolUse\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/capture-all-events.ts --event-type PostToolUse\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/stop-hook.ts\""
          },
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/capture-all-events.ts --event-type Stop\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/subagent-stop-hook.ts\""
          },
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/capture-all-events.ts --event-type SubagentStop\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/memory/capture.ts\"",
            "description": "PAI Memory System - Capture session transcript to queue"
          },
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/capture-session-summary.ts\""
          },
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/capture-all-events.ts --event-type SessionEnd\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/memory/retrieve.ts\"",
            "description": "PAI Memory System - Retrieve and inject relevant memory context"
          },
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/cleanup-temp-files.ts\""
          },
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/update-tab-titles.ts\""
          },
          {
            "type": "command",
            "command": "pwsh -Command \"bun run $env:PAI_DIR/hooks/capture-all-events.ts --event-type UserPromptSubmit\""
          }
        ]
      }
    ]
  }
}
