{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PAI_DIR": "$HOME/projects/pai",
    "PROJECTS_DIR": "$HOME/projects",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "PAI_CONFIG_DIR": "$HOME/.config/PAI",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_GIT_BASH_PATH": "C:/Program Files/Git/usr/bin/bash.exe"
  },
  "daidentity": {
    "name": "PAI",
    "personality": {
      "enthusiasm": 75,
      "energy": 80,
      "precision": 95
    }
  },
  "principal": {
    "name": "User",
    "timezone": "America/Chicago"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/StartupGreeting.hook.ts"
          },
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/LoadContext.hook.ts"
          },
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/CheckVersion.hook.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/SecurityValidator.hook.ts"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/SecurityValidator.hook.ts"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/SecurityValidator.hook.ts"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/SecurityValidator.hook.ts"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/SetQuestionTab.hook.ts"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/AgentExecutionGuard.hook.ts"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/SkillGuard.hook.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/QuestionAnswered.hook.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/AlgorithmTracker.hook.ts"
          }
        ]
      },
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/AlgorithmTracker.hook.ts"
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/AlgorithmTracker.hook.ts"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/AlgorithmTracker.hook.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/RatingCapture.hook.ts"
          },
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/AutoWorkCreation.hook.ts"
          },
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/UpdateTabTitle.hook.ts"
          },
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/SessionAutoName.hook.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/StopOrchestrator.hook.ts"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/WorkCompletionLearning.hook.ts"
          },
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/SessionSummary.hook.ts"
          },
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/RelationshipMemory.hook.ts"
          },
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/UpdateCounts.hook.ts"
          },
          {
            "type": "command",
            "command": "bun {{PAI_DIR}}/hooks/IntegrityCheck.hook.ts"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bun {{PAI_DIR}}/tools/statusline.ts"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true,
  "counts": {
    "skills": 0,
    "workflows": 0,
    "hooks": 0,
    "signals": 0,
    "files": 0,
    "updatedAt": ""
  },
  "effortLevel": "medium"
}
