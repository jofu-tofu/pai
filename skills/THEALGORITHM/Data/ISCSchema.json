{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ISC Table Schema",
  "description": "Ideal State Criteria table for THE ALGORITHM - structured output schema for guaranteed validation",
  "type": "object",
  "properties": {
    "request": {
      "type": "string",
      "description": "The user's original request",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "enum": ["TRIVIAL", "QUICK", "STANDARD", "THOROUGH", "DETERMINED"],
      "description": "Effort classification determining available capabilities"
    },
    "phase": {
      "type": "string",
      "enum": ["OBSERVE", "THINK", "PLAN", "BUILD", "EXECUTE", "VERIFY", "LEARN"],
      "description": "Current algorithm phase"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "description": "Current iteration number (starts at 1)"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when ISC was created"
    },
    "lastModified": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of last modification"
    },
    "rows": {
      "type": "array",
      "description": "Array of ISC criteria rows",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Unique row identifier"
          },
          "description": {
            "type": "string",
            "description": "What ideal looks like for this criterion",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["EXPLICIT", "INFERRED", "IMPLICIT"],
            "description": "Where this requirement came from"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "ACTIVE", "DONE", "ADJUSTED", "BLOCKED"],
            "description": "Current execution status"
          },
          "parallel": {
            "type": "boolean",
            "description": "Whether this row can execute in parallel with others",
            "default": true
          },
          "capability": {
            "type": "string",
            "description": "Assigned capability (e.g., research.perplexity, thinking.ultrathink)"
          },
          "capabilityIcon": {
            "type": "string",
            "description": "Icon for display (e.g., 🔬, 💡, 🤖)"
          },
          "result": {
            "type": "string",
            "description": "Execution result details"
          },
          "adjustedReason": {
            "type": "string",
            "description": "Reason for adjustment if status is ADJUSTED"
          },
          "blockedReason": {
            "type": "string",
            "description": "Reason for block if status is BLOCKED"
          },
          "verifyResult": {
            "type": "string",
            "enum": ["PASS", "ADJUSTED", "BLOCKED"],
            "description": "Verification result from VERIFY phase"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO timestamp when row was created"
          }
        },
        "required": ["id", "description", "source", "status", "timestamp"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "log": {
      "type": "array",
      "description": "Evolution log of all ISC changes",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": ["request", "effort", "phase", "iteration", "rows"],
  "additionalProperties": false
}