# PAI (Personal AI Infrastructure) .gitignore
# Generated: 2026-01-08

# ============================================
# ENVIRONMENT & SECRETS
# ============================================
# Contains API keys, credentials, user-specific config
.env
.env.*
!.env.example

# ============================================
# RUNTIME/SESSION DATA
# ============================================
# Transient session tracking - regenerated each session
.current-session
agent-sessions.json

# ============================================
# LOGS & HISTORY
# ============================================
# User-specific runtime data, learnings, session history
agentic_logs/
history/

# ============================================
# DEPENDENCIES
# ============================================
# Installed from package.json - never commit
**/node_modules/

# ============================================
# LOCK FILES
# ============================================
# Regenerated from package.json (optional - some prefer to commit these)
# Uncomment if you want deterministic builds:
**/bun.lock
**/bun.lockb
# **/package-lock.json

# ============================================
# BUILD & GENERATED FILES
# ============================================
# Compiled output, caches, coverage reports
**/dist/
**/build/
**/.cache/
**/coverage/

# Auto-generated skill index (regenerated by GenerateSkillIndex.ts)
skills/skill-index.json

# ============================================
# IDE & TOOL SETTINGS
# ============================================
# Claude Code local settings (user-specific permissions, credentials)
**/.claude/settings.local.json

# Skills junction (created by setup.ts fix - points to ../skills)
.claude/skills

# Include .claude/settings.json (hook definitions template with $env:PAI_DIR)

# ============================================
# USER-SPECIFIC SETTINGS
# ============================================
# Root settings.json contains user-specific env paths
/settings.json

# ============================================
# VOICE/MEDIA OUTPUT
# ============================================
# Runtime-generated audio files
voice/*.mp3
voice/*.wav
voice/*.ogg

# ============================================
# OS GENERATED
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# TEMP FILES
# ============================================
*.tmp
*.temp
*.swp
*~

# Windows artifacts
nul
NUL
