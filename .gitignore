# PAI (Personal AI Infrastructure) .gitignore
# Generated: 2026-01-08

# ============================================
# ENVIRONMENT & SECRETS
# ============================================
# Contains API keys, credentials, user-specific config
.env
.env.*
!.env.example

# ============================================
# RUNTIME/SESSION DATA
# ============================================
# Transient session tracking - regenerated each session
.current-session
agent-sessions.json


# ============================================
# LOGS & HISTORY
# ============================================
# User-specific runtime data, learnings, session history
agentic_logs/
history/

# ============================================
# MEMORY & STATE
# ============================================
# Local memory, state, and work tracking - never commit contents
# But preserve folder structure
MEMORY/**/*
!MEMORY/**/.gitkeep

# ============================================
# DEPENDENCIES
# ============================================
# Installed from package.json - never commit
**/node_modules/

# ============================================
# LOCK FILES
# ============================================
# Regenerated from package.json (optional - some prefer to commit these)
# Uncomment if you want deterministic builds:
**/bun.lock
**/bun.lockb
# **/package-lock.json

# ============================================
# BUILD & GENERATED FILES
# ============================================
# Compiled output, caches, coverage reports
**/dist/
**/build/
**/.cache/
**/coverage/

# Auto-generated skill index (regenerated by GenerateSkillIndex.ts)
skills/skill-index.json

# Local Epic-specific skills (development only, not committed)
skills/epic-*/

# ============================================
# IDE & TOOL SETTINGS
# ============================================
# Claude Code settings directory (user-specific, generated from template)
.claude/

# Windsurf IDE settings
.windsurf/
# But allow Windsurf template files
!**/templates/**/.windsurf/

# BMAD local files
_bmad/

# BMAD output files
bmad-output/
**/bmad-output/

# ============================================
# USER-SPECIFIC SETTINGS
# ============================================
# Root settings.json is generated from settings.template.json by expand-settings.ts
# Contains absolute paths specific to each user's installation
/settings.json
/settings.json.v*
/settings.backup-*.json

# ============================================
# VOICE/MEDIA OUTPUT
# ============================================
# Runtime-generated audio files
voice/*.mp3
voice/*.wav
voice/*.ogg

# ============================================
# OS GENERATED
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# BACKUPS
# ============================================
backups/

# ============================================
# TEMP FILES
# ============================================
*.tmp
*.temp
*.swp
*~
tmpclaude-*

# Windows artifacts
nul
NUL
_bmad-output/
# TruffleHog binaries (downloaded per-platform)
bin/trufflehog
bin/trufflehog.exe
hooks/subagent-stop-debug.log

# Generated output
_output/

# Release builds
Releases/

# AIW Installation
.aiwcli/
